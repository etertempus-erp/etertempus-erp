DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eter_erp
ENVIRONMENT=development
AUTH_REQUIRED=true
AUTH_SECRET_KEY=dev-only-change-me-before-beta
SESSION_COOKIE_NAME=eter_erp_session
SESSION_DURATION_MINUTES=480
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3000

# Solo para crear el primer administrador. No commitear valores reales.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador
